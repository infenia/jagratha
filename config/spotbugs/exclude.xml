<FindBugsFilter>
  <!-- Records intentionally expose internal collections by design for data access.
       The mutable collections (Map, Set, List, Array) are part of the record's contract. -->
  <Match>
    <Class name="com.infenia.yukta.service.orchestrator.assembly.AssemblyContext"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>

  <Match>
    <Class name="com.infenia.yukta.service.control.ExecutionControl"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>

  <Match>
    <Class name="com.infenia.yukta.service.execution.status.ExecutionStatusEvent"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>

  <Match>
    <Class name="com.infenia.yukta.service.control.WorkflowExecutionSnapshot"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>

  <!-- Exclude entire CLI module (untested new module) -->
  <Match>
    <Package name="com.infenia.yukta.cli.*"/>
  </Match>

  <!-- Exclude JTE generated code (UI module) -->
  <Match>
    <Package name="gg.jte.generated.**"/>
  </Match>
</FindBugsFilter>

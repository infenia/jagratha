meta {
  name: Stream Execution Logs
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/sessions/{{sessionId}}/executions/{{executionId}}/logs
  body: none
  auth: none
}

params:path {
  sessionId: {{sessionId}}
  executionId: {{executionId}}
}

headers {
  Accept: text/event-stream
}

script:post-response {
  if (res.status === 200) {
    console.log('Stream started successfully');
  }
}

tests {
  test("Stream execution logs - 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Response is array of log entries", function() {
    expect(res.body).to.be.an('array');
  });
  
  test("Log entries have required fields", function() {
    if (res.body.length > 0) {
      const entry = res.body[0];
      expect(entry).to.have.property('executionId');
      expect(entry).to.have.property('sessionId');
      expect(entry).to.have.property('nodeId');
      expect(entry).to.have.property('pluginId');
      expect(entry).to.have.property('stream');
      expect(entry).to.have.property('message');
      expect(entry).to.have.property('timestamp');
    }
  });
}

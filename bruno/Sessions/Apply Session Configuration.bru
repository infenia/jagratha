meta {
  name: Apply Session Configuration
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/sessions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "sessionId": "cli-spotless-session",
    "description": "CLI Spotless formatting workflow",
    "initiator": "spotless-cli",
    "projectPath": "$(pwd)",
    "tags": {},
    "workflows": {
      "spotless-check": {
        "workflowId": "spotless-check",
        "description": "Apply spotless code formatting",
        "nodes": [
          {
            "nodeId": "trigger",
            "type": "CONSTANT_SOURCE",
            "config": {}
          },
          {
            "nodeId": "spotless",
            "type": "PROCESS_EXECUTOR",
            "config": {
              "command": ["./gradlew", "spotlessApply"],
              "workingDirectory": "$(pwd)"
            }
          },
          {
            "nodeId": "terminal",
            "type": "CONSOLE_TERMINAL",
            "config": {}
          }
        ],
        "edges": [
          {
            "source": "trigger",
            "target": "spotless",
            "sourcePort": "default"
          },
          {
            "source": "spotless",
            "target": "terminal",
            "sourcePort": "default"
          }
        ]
      }
    }
  }
}

tests {
  test("Status code should be 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response should indicate successful configuration", function() {
    expect(res.body).to.have.property('statusCode', 200);
    expect(res.body).to.have.property('message');
  });
}
